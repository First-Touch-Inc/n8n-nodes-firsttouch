{
    "name":  "n8n-nodes-firsttouch",
    "version":  "0.1.0",
    "description":  "FirstTouch nodes for n8n: LinkedIn replies, accepted connections and post engagers as triggers; connection checks, messages, InMails, connection requests and flow enrollment as actions, with human approval on by default.",
    "license":  "MIT",
    "homepage":  "https://github.com/First-Touch-Inc/n8n-nodes-firsttouch#readme",
    "keywords":  [
                     "n8n-community-node-package",
                     "firsttouch",
                     "linkedin",
                     "hubspot",
                     "outreach"
                 ],
    "author":  {
                   "name":  "FirstTouch",
                   "url":  "https://www.firsttouch.com"
               },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/First-Touch-Inc/n8n-nodes-firsttouch.git"
                   },
    "scripts":  {
                    "build":  "n8n-node build",
                    "build:watch":  "tsc --watch",
                    "dev":  "n8n-node dev",
                    "lint":  "n8n-node lint",
                    "lint:fix":  "n8n-node lint --fix",
                    "release":  "n8n-node release",
                    "prepublishOnly":  "n8n-node prerelease",
                    "test":  "n8n-node build \u0026\u0026 node --test test/trigger.test.js"
                },
    "files":  [
                  "dist"
              ],
    "n8n":  {
                "n8nNodesApiVersion":  1,
                "strict":  true,
                "credentials":  [
                                    "dist/credentials/FirstTouchApi.credentials.js"
                                ],
                "nodes":  [
                              "dist/nodes/FirstTouch/FirstTouch.node.js",
                              "dist/nodes/FirstTouch/FirstTouchTrigger.node.js"
                          ]
            },
    "devDependencies":  {
                            "@n8n/node-cli":  "*",
                            "eslint":  "9.32.0",
                            "prettier":  "3.6.2",
                            "release-it":  "^21.1.0",
                            "typescript":  "5.9.2"
                        },
    "peerDependencies":  {
                             "n8n-workflow":  "*"
                         }
}